[22.5895, "o", "\u001b[2;68H\u001b[1mAdd\u001b[2;72HOpenTelemetry tracing\u001b[22m      \u001b[3;77H\u001b[38;5;7;49m2d\u001b[3;101Hapi-gateway\u001b[4;2H\u001b[39;49m    \u001b[38;5;9;49mclaude\u001b[39;49m \u001b[38;5;7;49mwebshop\u001b[39;49m            Fix flaky cart integration te \u001b[38;5;8;49m  3h\u001b[5;2H\u001b[1m\u001b[39;48;5;8m    \u001b[38;5;9;48;5;8mclaude\u001b[39;48;5;8m \u001b[38;5;7;48;5;8mapi-gateway\u001b[39;48;5;8m        Add OpenTelemetry tracing     \u001b[38;5;8;48;5;8m  2d\u001b[6;70H\u001b[22m\u001b[38;5;3;49mIn\u001b[6;74Hrument the gateway\u001b[6;93Hwith OpenTelemetry and \u001b[39;49m   \u001b[7;70H\u001b[38;5;3;49mexport to the collector.\u001b[9;70H\u001b[39;49mAdded the OTLP exporter\u001b[9;94Hand spans around upstream\u001b[10;70Hcalls, including the\u001b[10;91H\u001b[1m\u001b[38;5;0;48;5;3mRedis\u001b[22m\u001b[39;49m \u001b[1m\u001b[38;5;0;48;5;9mcache\u001b[22m\u001b[39;49m lookups. \u001b[10;113H    \u001b[11;68H     \u001b[11;74H   \u001b[11;78H   \u001b[11;82H      \u001b[11;89H     \u001b[11;95H   \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
